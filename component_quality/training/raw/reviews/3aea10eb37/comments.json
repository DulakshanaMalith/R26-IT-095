    "parentCommendId": null,
    "tags": [],
    "votes": [],
    "group": 2
  },
  {
    "id": 4145,
    "user": "Shelly Lawrence",
    "role": "assistant",
    "text": "In academic papers, indirect language should be used. Words like \"I,\" \"we,\" or similar terms should not be used.",
