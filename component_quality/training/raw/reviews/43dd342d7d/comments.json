    "group": 1
  },
  {
    "id": 3938,
    "user": "Anita Wong",
    "role": "student",
    "text": "elaborate on predefined threshold. If you can imagine what threshold and for which value it is going to be, then write it down. If you are not sure, write down something like this: \"To ensure privacy, a distance variable v = xyz is taken in consideration. It measures the relationship between x and y in z in xx category. Crucial is the meaning of z value, which threshold is going to be determined by the course of study, using blah blah blah...\"",
    "annotationId": 3872,
    "parentCommendId": null,
    "tags": [],
    "votes": [],
    "group": 1
  },
