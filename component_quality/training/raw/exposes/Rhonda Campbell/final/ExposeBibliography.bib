@inproceedings{kim_maintaining_2015,
	title = {Maintaining and Enhancing Human-Surrogate Presence in Augmented Reality},
	url = {https://ieeexplore.ieee.org/document/7344749},
	doi = {10.1109/ISMARW.2015.13},
	abstract = {We present some background and ideas related to a human's sense of presence with a human surrogate (a stand-in for a human) in an augmented reality ({AR}) setting. In particular we examine several factors related to human surrogates that are common to robotics, virtual reality, and augmented reality; and some challenges that are unique to {AR}. We then discuss the roles of surrogate characteristics and behaviors in maintaining and perhaps enhancing a sense of presence with a surrogate. We conclude by sharing some ideas for intentionally employing particular surrogate characteristics/behaviors that could simultaneously address the {AR}-specific challenges while maintaining and perhaps even enhancing the sense of co-presence/social presence with human surrogates in {AR}.},
	eventtitle = {2015 {IEEE} International Symposium on Mixed and Augmented Reality Workshops},
	pages = {15--19},
	booktitle = {2015 {IEEE} International Symposium on Mixed and Augmented Reality Workshops},
	author = {Kim, Kangsoo and Welch, Greg},
	urldate = {2024-12-04},
	date = {2015-09},
	keywords = {augmented reality, Augmented reality, avatar, Avatars, Context, context-aware, Human surrogates, Humanoid robots, presence, social interactions, Training, virtual human},
}
