@inproceedings{chidambaram_designing_2012,
	address = {New York, NY, USA},
	series = {{HRI} '12},
	title = {Designing persuasive robots: how robots might persuade people using vocal and nonverbal cues},
	isbn = {978-1-4503-1063-5},
	shorttitle = {Designing persuasive robots},
	url = {https://dl.acm.org/doi/10.1145/2157689.2157798},
	doi = {10.1145/2157689.2157798},
	abstract = {Social robots have to potential to serve as personal, organizational, and public assistants as, for instance, diet coaches, teacher's aides, and emergency respondents. The success of these robots - whether in motivating users to adhere to a diet regimen or in encouraging them to follow evacuation procedures in the case of a fire - will rely largely on their ability to persuade people. Research in a range of areas from political communication to education suggest that the nonverbal behaviors of a human speaker play a key role in the persuasiveness of the speaker's message and the listeners' compliance with it. In this paper, we explore how a robot might effectively use these behaviors, particularly vocal and bodily cues, to persuade users. In an experiment with 32 participants, we evaluate how manipulations in a robot's use of nonverbal cues affected participants' perceptions of the robot's persuasiveness and their compliance with the robot's suggestions across four conditions: (1) no vocal or bodily cues, (2) vocal cues only, (3) bodily cues only, and (4) vocal and bodily cues. The results showed that participants complied with the robot's suggestions significantly more when it used nonverbal cues than they did when it did not use these cues and that bodily cues were more effective in persuading participants than vocal cues were. Our model of persuasive nonverbal cues and experimental results have direct implications for the design of persuasive behaviors for humanlike robots.},
	urldate = {2024-12-08},
	booktitle = {Proceedings of the seventh annual {ACM}/{IEEE} international conference on {Human}-{Robot} {Interaction}},
	publisher = {Association for Computing Machinery},
	author = {Chidambaram, Vijay and Chiang, Yueh-Hsuan and Mutlu, Bilge},
	month = mar,
	year = {2012},
	pages = {293--300},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\97FH2FWQ\\Chidambaram et al. - 2012 - Designing persuasive robots how robots might persuade people using vocal and nonverbal cues.pdf:application/pdf},
}

@inproceedings{walker_influence_2019,
	title = {The {Influence} of {Size} in {Augmented} {Reality} {Telepresence} {Avatars}},
	url = {https://ieeexplore.ieee.org/abstract/document/8798152},
	doi = {10.1109/VR.2019.8798152},
	abstract = {In this work, we explore how advances in augmented reality technologies are creating a new design space for long-distance telepresence communication through virtual avatars. Studies have shown that the relative size of a speaker has a significant impact on many aspects of human communication including perceived dominance and persuasiveness. Our system synchronizes the body pose of a remote user with a realistic, virtual human avatar visible to a local user wearing an augmented reality head-mounted display. We conducted a two-by-two (relative system size: equivalent vs. small; leader vs. follower), between participants study (N = 40) to investigate the effect of avatar size on the interactions between remote and local user. We found the equal-sized avatars to be significantly more influential than the small-sized avatars and that the small avatars commanded significantly less attention than the equal-sized avatars. Additionally, we found the assigned leadership role to significantly impact participant subjective satisfaction of the task outcome.},
	urldate = {2024-12-08},
	booktitle = {2019 {IEEE} {Conference} on {Virtual} {Reality} and {3D} {User} {Interfaces} ({VR})},
	author = {Walker, Michael E. and Szafir, Daniel and Rae, Irene},
	month = mar,
	year = {2019},
	note = {ISSN: 2642-5254},
	keywords = {Augmented reality, avatar size, avatar telepresence systems, avatar-mediated communication, Avatars, Avatars, augmented reality, Collaboration, human-avatar interaction, Leadership, mixed reality, Robots, scenario-based design, team role, Telepresence},
	pages = {538--546},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\PE37XN67\\Walker et al. - 2019 - The Influence of Size in Augmented Reality Telepresence Avatars.pdf:application/pdf;IEEE Xplore Abstract Record:C\:\\Users\\lukas\\Zotero\\storage\\5ZRFY82P\\8798152.html:text/html},
}

@inproceedings{takayama_im_2009,
	address = {New York, NY, USA},
	series = {{CHI} '09},
	title = {I'm sorry, {Dave}: i'm afraid i won't do that: social aspects of human-agent conflict},
	isbn = {978-1-60558-246-7},
	shorttitle = {I'm sorry, {Dave}},
	url = {https://dl.acm.org/doi/10.1145/1518701.1519021},
	doi = {10.1145/1518701.1519021},
	abstract = {As computational agents become more sophisticated, it will frequently be necessary for the agents to disagree with users. In these cases, it might be useful for the agent to use politeness strategies that defuse the person's frustrations and preserve the human-computer relationship. One such strategy is distancing, which we implemented by spatially distancing an agent's voice from its body. In a 2 (agent disagreement: none vs. some) x 2 (agent voice location: on robotic body vs. in control box) between-participants experiment, we studied the effects of agent disagreement and agent voice location in a collaborative human-agent desert survival task (N=40). People changed their answers more often when agents disagreed with them and felt more similar to agents that always agreed with them, even when substantive content was identical. Strikingly, people felt more positively toward the disagreeing agent whose voice came from a separate control box rather than from its body; for agreement, the body-attached voice was preferred.},
	urldate = {2024-12-08},
	booktitle = {Proceedings of the {SIGCHI} {Conference} on {Human} {Factors} in {Computing} {Systems}},
	publisher = {Association for Computing Machinery},
	author = {Takayama, Leila and Groom, Victoria and Nass, Clifford},
	month = apr,
	year = {2009},
	pages = {2099--2108},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\ZEEPNPAF\\Takayama et al. - 2009 - I'm sorry, Dave i'm afraid i won't do that social aspects of human-agent conflict.pdf:application/pdf},
}

