	pages = {864--876},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\IX9UFC7N\\Nass et al. - 1997 - Are Machines Gender Neutral Gender-Stereotypic Responses to Computers With Voices.pdf:application/pdf;Snapshot:C\:\\Users\\lukas\\Zotero\\storage\\SDF4DGI5\\j.1559-1816.1997.tb00275.html:text/html},
}

@article{gilles_review_2022,
