}

@article{khan_attractive_2014,
	title = {Attractive {Agents} {Are} {More} {Persuasive}.},
	volume = {30},
	issn = {1044-7318},
	url = {https://research.ebsco.com/linkprocessor/plink?id=748b9e81-c870-3b1d-abd9-aaef49dbd546},
	doi = {10.1080/10447318.2013.839904},
	abstract = {Advances in more ubiquitous human–computer interface technologies have resulted in the increased use of virtual agents, thus highlighting the need to understand the impact these artificial entities have on the human user in terms of how the user both perceives and behaves toward these characters. We report the results of an experiment based on the Desert Survival task, where the effect of agent attractiveness on persuasion was tested. The results suggest that the attractive agent was significantly more persuasive in changing the participant's opinion than was the unattractive agent. Furthermore, greater behavioral change was observed when the participant interacted with the attractive agent, in terms of persuasiveness, including the attribution of more positive personality traits toward this agent (the attractiveness stereotype). These findings provide further evidence of the powerful influence of the agent's physical appearance on the human user in an interaction-based context. We conclude by pointing toward future research and potential within the area.},
	language = {eng},
	number = {2},
	urldate = {2025-02-14},
	journal = {International Journal of Human-Computer Interaction},
	author = {Khan, RabiaFatima and Sutcliffe, Alistair},
	month = feb,
	year = {2014},
	note = {Publisher: Taylor \& Francis Ltd},
	keywords = {COMPUTER interfaces, DESERT survival, HUMAN-computer interaction, PERSONALITY, PERSUASION (Psychology), USER interfaces},
	pages = {142--150},
	file = {Full text PDF:C\:\\Users\\lukas\\Zotero\\storage\\V6IP8NKC\\Khan und Sutcliffe - 2014 - Attractive Agents Are More Persuasive..pdf:application/pdf},
}

@inproceedings{zanbaka_can_2006,
	address = {New York, NY, USA},
	series = {{CHI} '06},
	title = {Can a virtual cat persuade you? the role of gender and realism in speaker persuasiveness},
	isbn = {978-1-59593-372-0},
	shorttitle = {Can a virtual cat persuade you?},
	url = {https://dl.acm.org/doi/10.1145/1124772.1124945},
	doi = {10.1145/1124772.1124945},
	abstract = {This study examines the roles of gender and visual realism in the persuasiveness of speakers. Participants were presented with a persuasive passage delivered by a male or female person, virtual human, or virtual character. They were then assessed on attitude change and their ratings of the argument, message, and speaker. The results indicated that the virtual speakers were as effective at changing attitudes as real people. Male participants were more persuaded when the speaker was female than when the speaker was male, whereas female participants were more persuaded when the speaker was male than when the speaker was female. Cross gender interactions occurred across all conditions, suggesting that some of the gender stereotypes that occur with people may carry over to interaction with virtual characters. Ratings of the perceptions of the speaker were more favorable for virtual speakers than for human speakers. We discuss the application of these findings in the design of persuasive human computer interfaces.},
	urldate = {2025-02-14},
	booktitle = {Proceedings of the {SIGCHI} {Conference} on {Human} {Factors} in {Computing} {Systems}},
	publisher = {Association for Computing Machinery},
	author = {Zanbaka, Catherine and Goolkasian, Paula and Hodges, Larry},
	month = apr,
	year = {2006},
	pages = {1153--1162},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\ICQIDEFX\\Zanbaka et al. - 2006 - Can a virtual cat persuade you the role of gender and realism in speaker persuasiveness.pdf:application/pdf},
}

@article{armando_impact_2022,
	title = {The {Impact} of {Pedagogical} {Agents}' {Gender} on {Academic} {Learning}: {A} {Systematic} {Review}},
	volume = {5},
	issn = {2624-8212},
	shorttitle = {The {Impact} of {Pedagogical} {Agents}' {Gender} on {Academic} {Learning}},
	url = {https://www.frontiersin.org/journals/artificial-intelligence/articles/10.3389/frai.2022.862997/full},
	doi = {10.3389/frai.2022.862997},
	abstract = {{\textless}p{\textgreater}Virtual learning environments often use virtual characters to facilitate and improve the learning process. These characters, known as pedagogical agents, can take on different roles, such as tutors or companions. Research has highlighted the importance of various characteristics of virtual agents, including their voice or non-verbal behaviors. Little attention has been paid to the gender-specific design of pedagogical agents, although gender has an important influence on the educational process. In this article, we perform an extensive review of the literature regarding the impact of the gender of pedagogical agents on academic outcomes. Based on a detailed review of 59 articles, we analyze the influence of pedagogical agents' gender on students' academic self-evaluations and achievements to answer the following questions: (1) Do students perceive virtual agents differently depending on their own gender and the gender of the agent? (2) Does the gender of pedagogical agents influence students' academic performance and self-evaluations? (3) Are there tasks or academic situations to which a male virtual agent is better suited than a female virtual agent, and vice versa, according to empirical evidence? (4) How do a virtual agent's pedagogical roles impact these results? (5) How do a virtual agent's appearance and interactive capacities impact these results? (6) Are androgynous virtual agents a potential solution to combatting gender stereotypes? This review provides important insight to researchers on how to approach gender when designing pedagogical agents in virtual learning environments.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2025-02-15},
	journal = {Frontiers in Artificial Intelligence},
	author = {Armando, Marjorie and Ochs, Magalie and Régner, Isabelle},
	month = jun,
	year = {2022},
	note = {Publisher: Frontiers},
	keywords = {gender, Gender stereotypes, Learning environment, Pedagogical agent, Systematic review, virtual agent},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\FXP7HY8I\\Armando et al. - 2022 - The Impact of Pedagogical Agents' Gender on Academic Learning A Systematic Review.pdf:application/pdf},
}

@article{nass_are_1997,
	title = {Are {Machines} {Gender} {Neutral}? {Gender}-{Stereotypic} {Responses} to {Computers} {With} {Voices}},
	volume = {27},
	issn = {1559-1816},
	shorttitle = {Are {Machines} {Gender} {Neutral}?},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1559-1816.1997.tb00275.x},
	doi = {10.1111/j.1559-1816.1997.tb00275.x},
	abstract = {This study tested whether computers embedded with the most minimal gender cues will evoke gender-based stereotypic responses. Using an experimental paradigm (N = 40) that involved computers with voice output, the study tested 3 gender-based stereotypes under conditions in which all suggestions of gender were removed, with the sole exception of vocal cues. In all 3 cases, gender-stereotypic responses were obtained. Because the experimental manipulation involved no deception regarding the source of the voices. this study presents evidence that the tendency to gender stereotype is extremely powerful, extending even to stereotyping of machines.},
	language = {en},
	number = {10},
	urldate = {2025-02-15},
	journal = {Journal of Applied Social Psychology},
	author = {Nass, Clifford and Moon, Youngme and Green, Nancy},
	year = {1997},
