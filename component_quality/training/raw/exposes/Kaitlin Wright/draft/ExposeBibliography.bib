@article{gonzalez-franco_rocketbox_2020,
	title = {The {Rocketbox} {Library} and the {Utility} of {Freely} {Available} {Rigged} {Avatars}},
	volume = {1},
	issn = {2673-4192},
	url = {https://www.frontiersin.org/journals/virtual-reality/articles/10.3389/frvir.2020.561558/full},
	doi = {10.3389/frvir.2020.561558},
	abstract = {{\textless}p{\textgreater}As part of the open sourcing of the Microsoft Rocketbox avatar library for research and academic purposes, here we discuss the importance of rigged avatars for the Virtual and Augmented Reality (VR, AR) research community. Avatars, virtual representations of humans, are widely used in VR applications. Furthermore many research areas ranging from crowd simulation to neuroscience, psychology, or sociology have used avatars to investigate new theories or to demonstrate how they influence human performance and interactions. We divide this paper in two main parts: the first one gives an overview of the different methods available to create and animate avatars. We cover the current main alternatives for face and body animation as well introduce upcoming capture methods. The second part presents the scientific evidence of the utility of using rigged avatars for embodiment but also for applications such as crowd simulation and entertainment. All in all this paper attempts to convey why rigged avatars will be key to the future of VR and its wide adoption.{\textless}/p{\textgreater}},
	language = {English},
	urldate = {2024-12-09},
	journal = {Frontiers in Virtual Reality},
	author = {Gonzalez-Franco, Mar and Ofek, Eyal and Pan, Ye and Antley, Angus and Steed, Anthony and Spanlang, Bernhard and Maselli, Antonella and Banakou, Domna and Pelechano, Nuria and Orts-Escolano, Sergio and Orvalho, Veronica and Trutoiu, Laura and Wojcik, Markus and Sanchez-Vives, Maria V. and Bailenson, Jeremy and Slater, Mel and Lanier, Jaron},
	month = nov,
	year = {2020},
	note = {Publisher: Frontiers},
	keywords = {animation, augmented reality, Avatars, Blendshapes, Human Computer Interaction (HCI), Microsoft Rocketbox, motion capture, rigging, virtual reality, Volumetric},
	file = {Full Text PDF:C\:\\Users\\lukas\\Zotero\\storage\\IHJ8438M\\Gonzalez-Franco et al. - 2020 - The Rocketbox Library and the Utility of Freely Available Rigged Avatars.pdf:application/pdf},
