	urldate = {2024-12-08},
	journal = {Radiology},
	author = {Yoon, Jung                         Hyun and Strand, Fredrik and Baltzer, Pascal A.                             T. and Conant, Emily                             F. and Gilbert, Fiona                             J. and Lehman, Constance                             D. and Morris, Elizabeth                             A. and Mullen, Lisa                         A. and Nishikawa, Robert                             M. and Sharma, Nisha and Vejborg, Ilse and Moy, Linda and Mann, Ritse                         M.},
	month = jun,
