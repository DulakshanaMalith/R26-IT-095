	url = {https://www.sciencedirect.com/science/article/pii/S036301881830121X},
	doi = {10.1067/j.cpradiol.2018.08.010},
	abstract = {Interval breast cancers are those detected in the interim between regular screening examinations and are an unfortunate reality for breast cancer screening programs. However, their incidence can help gauge the success of breast cancer screening programs. There are four main categories of interval cancers, including true negative, false negative, minimal sign, and occult. The mammographic characteristics of each type of interval cancer are reviewed with example cases from an urban academic institution. Pitfalls and strategies to reduce interval cancers are discussed in detail.},
