# PostgreSQL database used exclusively by the scheduling component.
# Add :password after postgres when your local server requires a password.
SCHEDULING_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ipms_scheduling

# Local demo is the default. Production refuses demo staff credentials and the
# test-only student portal until institution-approved authentication is added.
IPMS_ENV=development
# Localhost by default; set a network address only after configuring proper
# authentication, HTTPS/reverse proxy, and trusted origins.
IPMS_BIND_HOST=127.0.0.1
# In production, list only the deployed frontend origins, comma-separated.
# IPMS_CORS_ORIGINS=https://your-institution.example

# Leave disabled on memory-constrained machines. Evidence-based WBS/Gantt/
# objectives/methodology extraction remains active without this optional model.
ENABLE_T5_WBS=0

# Optional semantic panel matching. The default TF-IDF matcher is lightweight
# and does not download a Hugging Face model.
ENABLE_SENTENCE_TRANSFORMER=0

# Replace this value before exposing IPMS outside a trusted local machine.
IPMS_AUTH_SECRET=replace-with-a-long-random-secret

# Optional JSON user map. When omitted, the local demo accounts are enabled.
# IPMS_AUTH_USERS_JSON={"staff1":{"password":"change-me","role":"staff","display":"Academic Staff"}}

# Optional override for the shared component key. When omitted locally, the
# scheduling service and standalone portal share an automatically generated
# secret stored under .runtime/ (which is excluded from Git).
IPMS_SUBMISSION_INTEGRATION_KEY=replace-with-a-long-random-integration-key

# Standalone student portal target (portal runs separately on port 8010).
SCHEDULING_API_URL=http://127.0.0.1:8000

# Configure the same secret in GitHub repository Settings > Webhooks. Unsigned
# and incorrectly signed webhook requests are rejected.
IPMS_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-github-secret

# Maximum accepted document size in bytes (default shown: 20 MiB).
IPMS_MAX_SUBMISSION_BYTES=20971520
